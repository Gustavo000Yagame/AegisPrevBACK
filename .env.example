# ===============================
# DATABASE - SUPABASE / POSTGRES
# ===============================
# String de conexão completa do Supabase (Settings > Database > Connection string > URI)
# Exemplo: postgresql://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:senha@localhost:5432/AegisPrev

# Se sua conexão não exigir SSL (ex: Postgres local), defina PGSSL=false
PGSSL=true

# ===============================
# JWT
# ===============================
# IMPORTANTE: precisa ser uma string em Base64 (mesmo formato usado antes no backend Java)
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
JWT_EXPIRATION=86400000

# ===============================
# CORS - VERCEL
# ===============================
# Pode colocar várias origens separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# ===============================
# SERVER
# ===============================
PORT=8080
